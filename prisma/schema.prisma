generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categorie {
  id     String  @id @default(cuid())
  nom    String
  couleur String  
  taches Taches[] // une catégorie peut avoir plusieurs tâches
}

model Taches {
  id           String     @id @default(cuid())
  titre        String
  fait         Boolean    @default(false)
  dateCreation DateTime   @default(now())
  dateEcheance DateTime?  // "?" = optionnel, une tâche peut ne pas avoir de date limite
  categorieId  String?    // "?" = optionnel, une tâche peut n'avoir aucune catégorie
  categorie    Categorie? @relation(fields: [categorieId], references: [id])
}